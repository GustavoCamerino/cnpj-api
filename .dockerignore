# Arquivos que NÃO vão para dentro da imagem Docker.
# Deixa o build mais rápido e evita levar segredos ou lixo local para a imagem.

# Dependências são instaladas DENTRO da imagem (composer install)
vendor
node_modules

# Configuração e segredos locais: no container, tudo vem do docker-compose.yml
.env
.env.*
!.env.example

# Banco SQLite local e arquivos gerados
database/*.sqlite
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache

# Versionamento, editores e o próprio Docker
.git
.idea
.vscode
Dockerfile
docker-compose.yml
.dockerignore
